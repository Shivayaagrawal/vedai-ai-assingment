[{"text": "Page 2", "y": 0.023454966305922448}, {"text": "Q4", "y": 0.04350175212683171}, {"text": "P = lowest point (max speed, max KE,min PE).Q andR are the extremepoints wherethe bob momentarily stops", "y": 0.07425751196829933}, {"text": "(maxPE, KE = 0). As the bobmoves from R to P, PE convertsinto KE.", "y": 0.09871022245079973}, {"text": "P (max KE, min PE)", "y": 0.2082020277344684}, {"text": "Q", "y": 0.1610638856413902}, {"text": "Q8(a)", "y": 0.24252065571070247}, {"text": "Specific heat capacity is the heat needed to raise the temperature of 1 kg of a", "y": 0.2725542287169296}, {"text": "substance by 1 degree Celsius.", "y": 0.29681233697963433}, {"text": "Q8(b)", "y": 0.32972601196416695}, {"text": "Q = m c (delta)T = 2 x 4200 x 60 = 504000 J", "y": 0.35977026027145204}, {"text": "Q11(b)", "y": 0.39879658726755934}, {"text": "In molten", "y": 0.4311742497673908}, {"text": "NaCl the", "y": 0.4312906449853779}, {"text": "ions are free", "y": 0.4240784913381803}, {"text": "to move", "y": 0.4305991247195604}, {"text": "and carry", "y": 0.43409765105677867}, {"text": "charge", "y": 0.43061347928397115}, {"text": "but", "y": 0.4366871999769167}, {"text": "in", "y": 0.4331816051041931}, {"text": "solid", "y": 0.42647548610137426}, {"text": "NaCl", "y": 0.43868070823390864}, {"text": "the", "y": 0.43254453068621634}, {"text": "ions", "y": 0.4330228711709743}, {"text": "arefixed", "y": 0.42635176860558166}, {"text": "in thelattice", "y": 0.4288813618450748}, {"text": "and", "y": 0.46035718796113134}, {"text": "cannot move so it cannot", "y": 0.45414383650528123}, {"text": "conduct", "y": 0.44703423099626044}, {"text": "electricity.", "y": 0.4567382427780229}, {"text": "Q20", "y": 0.4926599602335067}, {"text": "The mitochondria produces ATP through cellularrespiration.", "y": 0.5233547313006787}, {"text": "Q9", "y": 0.5612166348812145}, {"text": "1. Plant cells have a cellwall, animal cells do not.", "y": 0.592374340650633}, {"text": "2. Plant cells have chloroplasts and a largevacuole, animal cells usually donot.", "y": 0.6165732000862434}, {"text": "Q12", "y": 0.659663282517692}, {"text": "(diagram- humandigestive system)", "y": 0.6924769467870497}, {"text": "mouth", "y": 0.7305543863271469}, {"text": "oesophagus", "y": 0.7844265590760648}, {"text": "stomach", "y": 0.8382985143315826}]