[{"text": "Page 1", "y": 0.023454966305922448}, {"text": "Name: Aanya Sharma Roll No: 23 Class: 10-B", "y": 0.044794084317261396}, {"text": "Q10", "y": 0.09804713944705348}, {"text": "4 Fe +3 O2 -> 2 Fe2O3(balanced)", "y": 0.12874307954125133}, {"text": "Q3", "y": 0.16844660848766543}, {"text": "2x^2 - 5x + 3 = 0", "y": 0.1991854763417204}, {"text": "x = [5 +/- sqrt(25 - 24)]/ 4 = (5 +/- 1)/4", "y": 0.2233505880514056}, {"text": "so x = 1.5 or x = 1", "y": 0.24764400274273676}, {"text": "Q1", "y": 0.2847855500574835}, {"text": "Inertiais thetendencyof a body to resist any changein its state ofrest orof uniformmotion.", "y": 0.31533693860059814}, {"text": "6 CO2+ 6 H2O +light energy -> C6H12O6 +6 O2 (photosynthesis)", "y": 0.35821521870918827}, {"text": "Q7", "y": 0.3967003496278905}, {"text": "Ice floats because it is lighter than water.", "y": 0.42950219675583945}, {"text": "Icefloats on water because ice is less densethan liquid water - the hexagonal crystalstructure formedonfreezing", "y": 0.4516909459382455}, {"text": "takes up morespace than the liquid.", "y": 0.4759957246597352}, {"text": "Q11", "y": 0.5148822396484378}, {"text": "Ice is less denseso it floats ontop of water.", "y": 0.5427162475254689}, {"text": "Q1", "y": 0.5843831256440524}, {"text": "Mitochondriais thepowerhouse of the cell.", "y": 0.6148208557611319}]